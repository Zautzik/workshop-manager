

# NextAuth Configuration
NEXTAUTH_URL="http://localhost:3000"
# Generate a secret with: openssl rand -base64 32
NEXTAUTH_SECRET="<generate-a-unique-secret-do-not-copy-this>"

# Development-only auth bypass (client + server)
# NEVER set this to true in production/staging/shared environments.
# The app fails fast on non-development builds when this is true.
NEXT_PUBLIC_DEV_BYPASS="false"

# WhatsApp Webhook
# Provider shape both webhooks (/api/whatsapp/webhook and
# /api/whatsapp/warehouse/webhook) expect. Options:
#   meta    — WhatsApp Cloud API: X-Hub-Signature-256 (sha256=<hex> HMAC of the
#             raw body, keyed with the Meta App Secret) + nested Graph payload.
#             Use this for the Meta test number AND the production number.
#   generic — legacy/custom scheme: base64 HMAC-SHA256 of the raw body over a
#             flat { from, body } JSON payload (curl testing, simulators).
# Defaults to "generic" when unset.
WHATSAPP_PROVIDER="meta"
# Signature verification key — required, no default (webhooks fail closed).
#   meta:    App Secret from Meta App Dashboard → App settings → Basic
#   generic: any shared HMAC key
WHATSAPP_AUTH_TOKEN="<your-meta-app-secret-or-shared-hmac-key>"
# Token matched against hub.verify_token during the GET verification handshake
WHATSAPP_VERIFY_TOKEN="<your-chosen-verify-token>"
# Graph API bearer token (System User / Page Access Token) — a DIFFERENT
# credential from WHATSAPP_AUTH_TOKEN above (that one verifies inbound
# signatures; this one authenticates outbound Graph API calls). Used to
# download inbound media (whatsapp-media.ts) and, as of whatsapp-send.ts, to
# send outbound messages. Required only for provider=meta.
WHATSAPP_ACCESS_TOKEN="<your-graph-api-access-token>"
# The sending number's Phone Number ID from the Meta App Dashboard (WhatsApp
# > API Setup) — required by whatsapp-send.ts's POST /{id}/messages call.
WHATSAPP_PHONE_NUMBER_ID="<your-phone-number-id>"

# Vercel Cron auth — Vercel sends `Authorization: Bearer $CRON_SECRET` on
# cron-triggered requests when this is set (Vercel project settings also
# needs this same value under Environment Variables for it to be attached
# automatically). Optional in dev: /api/cron/* routes skip the check when
# unset, matching this project's other best-effort auth checks.
CRON_SECRET="<generate-a-random-secret>"

# Sentry (Error Tracking)
# Client-side DSN (safe to expose via NEXT_PUBLIC_ prefix)
NEXT_PUBLIC_SENTRY_DSN=""
# Optional: server/edge DSN override; falls back to NEXT_PUBLIC_SENTRY_DSN when empty
SENTRY_DSN=""
# Sampling (0.0-1.0). Keep low in production initially.
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE="0.1"
SENTRY_TRACES_SAMPLE_RATE="0.1"
# Optional environment tag shown in Sentry issues (e.g. development, staging, production)
SENTRY_ENVIRONMENT=""

# Optional: release/source map upload during build (only needed in CI/CD)
SENTRY_AUTH_TOKEN=""
SENTRY_ORG=""
SENTRY_PROJECT=""

# ─────────────────────────────────────────────────────────────────────────────
# Supabase
# ─────────────────────────────────────────────────────────────────────────────
# Estas cinco faltaban por completo en este archivo aunque el README dice
# "copy .env.example" para la "Supabase URL + keys" — copiarlo dejaba la
# aplicación sin base de datos y sin un mensaje que lo explicara.
#
# Hay DOS pares de URL/key a propósito:
#   NEXT_PUBLIC_*  viajan al navegador (bundle del cliente). Rol `anon`.
#   sin prefijo    sólo servidor.
#
# La publishable key es pública por diseño: lo único que impide que lea toda la
# base es RLS. No es un secreto, pero tampoco es inofensiva — ver
# docs/audit-remediation-plan-2026-10-14.md §2.
NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="<publishable-key-del-dashboard>"

# Lado servidor. `SUPABASE_URL` suele ser la misma URL de arriba.
SUPABASE_URL="https://<project-ref>.supabase.co"
SUPABASE_ANON_KEY="<anon-key>"

# ⚠ SERVICE ROLE: pasa por encima de RLS, acceso total. NUNCA con prefijo
#   NEXT_PUBLIC_, nunca en el navegador, nunca en un commit.
SUPABASE_SERVICE_ROLE_KEY="<service-role-key>"

# ─────────────────────────────────────────────────────────────────────────────
# Operación y utilidades
# ─────────────────────────────────────────────────────────────────────────────
# Nivel de log de pino. trace|debug|info|warn|error|fatal. Default: info.
LOG_LEVEL="info"

# Qué usuario simula el bypass de desarrollo. Sólo aplica con
# NEXT_PUBLIC_DEV_BYPASS=true; en un build desplegado el build falla.
DEV_BYPASS_USER_ID=""

# scripts/seed-admin.ts — el primer administrador de una base nueva.
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""

# scripts/smoke.mjs — contra qué instancia corre. Default http://localhost:3000
SMOKE_BASE_URL="http://localhost:3000"

# Devuelve respuestas falsas en lugar de llamar al Graph API de Meta.
# Para probar el flujo de WhatsApp sin mandar mensajes reales.
WHATSAPP_SIMULATOR="false"
